rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLAS TEMPORALES PARA DESARROLLO
    // ⚠️ Estas reglas permiten que cualquier usuario autenticado pueda leer y escribir todo
    // Úsalas SOLO para desarrollo y pruebas
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}


